{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "dev:mock": "CMS_ADAPTER=mock astro dev --port 4323",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf:export": "contentful-export --space-id $CONTENTFUL_SPACE_ID --management-token $CONTENTFUL_MANAGEMENT_TOKEN --export-dir contentful --content-file snapshot.json",
    "cf:migrate": "for f in src/cms/adapters/contentful/migrations/*.cjs; do contentful-migration --space-id $CONTENTFUL_SPACE_ID --access-token $CONTENTFUL_MANAGEMENT_TOKEN --yes \"$f\"; done",
    "cf:import": "contentful-import --space-id $CLIENT_SPACE_ID --management-token $CLIENT_MANAGEMENT_TOKEN --content-file contentful/snapshot.json"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.1",
    "@contentful/rich-text-html-renderer": "^17.1.6",
    "animate.css": "^4.1.1",
    "astro": "^5.18.0",
    "contentful": "^11.10.3"
  },
  "devDependencies": {
    "contentful-export": "^7.22.4",
    "contentful-import": "^9.4.133",
    "contentful-management": "^11.74.0",
    "contentful-migration": "^4.31.9",
    "dotenv": "^17.3.1",
    "sass": "^1.97.3",
    "vitest": "^4.0.18"
  }
}
