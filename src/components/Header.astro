---
import NavElement from "./NavElement.astro";
import NavBrand from "./NavBrand.astro";

import type {
    NavElement as NavElementType,
    NavBrand as NavBrandType,
    Distribution,
    Alignment,
    MobileAlignment,
} from "@/types/nav";

import {
    injectBrandElement,
    isNavBrand,
    getOrderFromDistribution,
} from "@/utils/nav";

interface Props {
    distribution?: Distribution;
    alignment?: Alignment;
    navElements?: NavElementType[];
    brandElement?: NavBrandType;
    mobileAlignment?: MobileAlignment;
}

const {
    distribution = "center",
    alignment = "center",
    navElements = [],
    brandElement,
    mobileAlignment = "left",
} = Astro.props as Props;

function getNavContainerAlignmentClass(value: unknown): string {
    switch (value) {
        case "left":
            return "nav-container--align-left";
        case "right":
            return "nav-container--align-right";
        default:
            return "nav-container--align-center";
    }
}

function getNavContainerMobileAlignmentClass(value: unknown): string {
    switch (value) {
        case "right":
            return "nav-container--mobile-right";
        default:
            return "nav-container--mobile-left";
    }
}

const order = getOrderFromDistribution(distribution);

const brandInjectedNavElements = injectBrandElement(brandElement, navElements);

const navContainerClasses = [
    "nav-container",
    getNavContainerAlignmentClass(alignment),
    getNavContainerMobileAlignmentClass(mobileAlignment),
].join(" ");
---

<nav class={navContainerClasses}>
    <ul class="nav-bar">
        {
            brandInjectedNavElements.map((item) => {
                return isNavBrand(item) ? (
                    <li class="nav-brand">
                        <NavBrand element={item} />
                    </li>
                ) : (
                    <li>
                        <NavElement element={item} />
                    </li>
                );
            })
        }
    </ul>
</nav>

<style define:vars={{ order }}>
    .nav-container {
        width: 100%;
        display: flex;
    }

    .nav-container--align-left {
        justify-content: flex-start;
    }

    .nav-container--align-center {
        justify-content: center;
    }

    .nav-container--align-right {
        justify-content: flex-end;
    }

    /* Keep mobile placement independently configurable from desktop alignment. */
    @media (max-width: 767px) {
        .nav-container--mobile-left {
            justify-content: flex-start;
        }

        .nav-container--mobile-right {
            justify-content: flex-end;
        }
    }

    .nav-bar {
        width: min(100%, 1200px);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        list-style: none;
        margin: 0;
        padding: 0.5rem 1rem;
    }

    .nav-bar > li {
        display: inline-flex;
    }

    .nav-brand {
        order: var(--order);
    }
</style>
