---
import type { Footer } from "@/types/page";

interface Props {
    footer: Footer | null;
}

const { footer } = Astro.props;
---

{footer && (
    <footer class="site-footer">
        <div class="site-footer__inner">

            {/* ── Main row: brand | columns | social ────────────────────── */}
            <div class="site-footer__main">
                <div class="site-footer__brand-block">
                    <a class="site-footer__brand" href="/">
                        <img src="/logo.svg" alt="Digital Hub" class="site-footer__logo" />
                    </a>
                    {footer.tagline && (
                        <p class="site-footer__tagline">{footer.tagline}</p>
                    )}
                </div>

                {/* Link columns */}
                {footer.columns && footer.columns.length > 0 && (
                    <div class="site-footer__columns">
                        {footer.columns.map(col => (
                            <div class="site-footer__column">
                                {col.title && (
                                    <h3 class="site-footer__column-title">{col.title}</h3>
                                )}
                                {col.links && col.links.length > 0 && (
                                    <ul class="site-footer__column-links">
                                        {col.links.map(link => (
                                            <li>
                                                <a
                                                    href={link.href}
                                                    target={link.openInNewTab ? '_blank' : undefined}
                                                    rel={link.openInNewTab ? 'noopener noreferrer' : undefined}
                                                >
                                                    {link.label}
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                )}
                            </div>
                        ))}
                    </div>
                )}

                {/* Social links */}
                {footer.socialLinks && footer.socialLinks.length > 0 && (
                    <div class="site-footer__social">
                        {footer.socialLinks.map(link => (
                            <a
                                href={link.href}
                                aria-label={link.label}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="site-footer__social-link"
                            >
                                {link.icon === 'linkedin' && (
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                        <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2z"/>
                                        <circle cx="4" cy="4" r="2"/>
                                    </svg>
                                )}
                                {link.icon === 'instagram' && (
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/>
                                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                                        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
                                    </svg>
                                )}
                                {link.icon === 'twitter' && (
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                                    </svg>
                                )}
                                {link.icon === 'facebook' && (
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                        <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>
                                    </svg>
                                )}
                                <span class="sr-only">{link.label}</span>
                            </a>
                        ))}
                    </div>
                )}
            </div>

            {/* ── Legal row ─────────────────────────────────────────────── */}
            {(footer.copyright || (footer.legalLinks && footer.legalLinks.length > 0)) && (
                <div class="site-footer__legal">
                    {footer.copyright && (
                        <span class="site-footer__copyright">{footer.copyright}</span>
                    )}
                    {footer.legalLinks && footer.legalLinks.length > 0 && (
                        <ul class="site-footer__legal-links">
                            {footer.legalLinks.map(link => (
                                <li>
                                    <a
                                        href={link.href}
                                        target={link.openInNewTab ? '_blank' : undefined}
                                        rel={link.openInNewTab ? 'noopener noreferrer' : undefined}
                                    >
                                        {link.label}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    )}
                </div>
            )}
        </div>

    </footer>
)}

<style>
    .site-footer {
        background-color: #07070E;
        color: #F4F4EE;
        padding-top: 4rem;
        padding-inline: 1.5rem;
        overflow: hidden;
        position: relative;
    }

    .site-footer__inner {
        max-width: 1200px;
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    /* ── Main row ─────────────────────────────────────────────────────────── */
    .site-footer__main {
        display: grid;
        grid-template-columns: 220px 1fr auto;
        gap: 3rem;
        align-items: start;
    }

    .site-footer__brand-block {
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
    }

    .site-footer__brand {
        display: inline-flex;
        align-items: center;
        text-decoration: none !important;
    }

    .site-footer__logo {
        height: 64px;
        width: auto;
        object-fit: contain;
    }

    .site-footer__tagline {
        color: rgba(123,201,245,0.65);
        font-size: 0.875rem;
        margin: 0;
        max-width: 36ch;
        line-height: 1.55;
    }

    /* ── Social icons ─────────────────────────────────────────────────────── */
    .site-footer__social {
        display: flex;
        gap: 0.625rem;
        align-items: center;
    }

    .site-footer__social-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 0.5rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: rgba(123,201,245,0.75);
        text-decoration: none;
        transition: background 0.15s, color 0.15s, border-color 0.15s;
    }

    .site-footer__social-link:hover {
        background: rgba(255, 0, 135, 0.1);
        border-color: rgba(255, 0, 135, 0.3);
        color: #ff0087;
    }

    /* ── Columns ──────────────────────────────────────────────────────────── */
    .site-footer__columns {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }

    .site-footer__column-title {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        color: rgba(123,201,245,0.55);
        margin: 0 0 1rem;
    }

    .site-footer__column-links {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 0.625rem;
    }

    .site-footer__column-links a {
        color: rgba(123,201,245,0.8);
        text-decoration: none;
        font-size: 0.9375rem;
        transition: color 0.15s;
    }

    .site-footer__column-links a:hover {
        color: #F4F4EE;
    }

    /* ── Legal row ────────────────────────────────────────────────────────── */
    .site-footer__legal {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-top: 1.5rem;
        padding-bottom: 1.5rem;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        color: rgba(123,201,245,0.45);
        font-size: 0.8125rem;
    }

    .site-footer__copyright {
        letter-spacing: 0.01em;
    }

    .site-footer__legal-links {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 1.5rem;
    }

    .site-footer__legal-links a {
        color: inherit;
        text-decoration: none;
        transition: color 0.15s;
    }

    .site-footer__legal-links a:hover {
        color: rgba(123,201,245,0.8);
    }


    /* ── Accessibility ────────────────────────────────────────────────────── */
    .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border-width: 0;
    }

    /* ── Mobile ───────────────────────────────────────────────────────────── */
    @media (max-width: 767px) {
        .site-footer__main {
            grid-template-columns: 1fr;
            gap: 2rem;
        }

        .site-footer__columns {
            grid-template-columns: repeat(2, 1fr);
        }

        .site-footer__social {
            justify-content: flex-start;
        }

        .site-footer__legal {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @media (max-width: 400px) {
        .site-footer__columns {
            grid-template-columns: 1fr;
        }
    }
</style>
