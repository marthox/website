---
import type { Form } from '@/types/page';

interface Props {
    form: Form;
}

const { form } = Astro.props;
const formName = form.type ?? 'contact';
---

<form
    class="form"
    data-type={form.type}
    data-theme={form.theme}
    name={formName}
    method="POST"
    data-netlify="true"
>
    <input type="hidden" name="form-name" value={formName} />

    {form.title && <h2 class="form__title">{form.title}</h2>}
    {form.subtitle && <p class="form__subtitle">{form.subtitle}</p>}

    {form.fields && form.fields.length > 0 && (
        <div class="form__fields">
            {form.fields.map(field => (
                <div class="form__field">
                    <label class="form__label" for={field.name}>
                        {field.label}
                        {field.required && <span class="form__required" aria-hidden="true">*</span>}
                    </label>

                    {field.type === 'textarea' ? (
                        <textarea
                            id={field.name}
                            name={field.name}
                            placeholder={field.placeholder}
                            required={field.required}
                            class="form__input form__input--textarea"
                        />
                    ) : field.type === 'select' ? (
                        <select
                            id={field.name}
                            name={field.name}
                            required={field.required}
                            class="form__input form__input--select"
                        >
                            <option value="">{field.placeholder ?? 'Select an option'}</option>
                            {field.options?.map(opt => (
                                <option value={opt}>{opt}</option>
                            ))}
                        </select>
                    ) : field.type === 'checkbox' ? (
                        <label class="form__checkbox-label">
                            <input
                                type="checkbox"
                                id={field.name}
                                name={field.name}
                                required={field.required}
                                class="form__checkbox"
                            />
                            {field.placeholder}
                        </label>
                    ) : field.type === 'radio' && field.options ? (
                        <div class="form__radio-group">
                            {field.options.map(opt => (
                                <label class="form__radio-label">
                                    <input
                                        type="radio"
                                        name={field.name}
                                        value={opt}
                                        required={field.required}
                                        class="form__radio"
                                    />
                                    {opt}
                                </label>
                            ))}
                        </div>
                    ) : (
                        <input
                            type={field.type}
                            id={field.name}
                            name={field.name}
                            placeholder={field.placeholder}
                            required={field.required}
                            class="form__input"
                        />
                    )}

                    {field.helpText && <p class="form__help">{field.helpText}</p>}
                </div>
            ))}
        </div>
    )}

    <button type="submit" class="form__submit">
        {form.submitLabel ?? 'Submit'}
    </button>
</form>

<style>
    .form {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }

    .form__title {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
    }

    .form__subtitle {
        margin: 0;
        color: var(--section-text-muted);
    }

    .form__fields {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .form__field {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }

    .form__label {
        font-size: 0.875rem;
        font-weight: 600;
    }

    .form__required {
        color: red;
        margin-left: 0.25rem;
    }

    .form__input {
        padding: 0.625rem 0.875rem;
        border: 1px solid var(--section-border);
        border-radius: 0.375rem;
        font-size: 1rem;
        background-color: var(--section-surface);
        color: var(--section-text);
        width: 100%;
        box-sizing: border-box;
    }

    .form__input--textarea {
        min-height: 8rem;
        resize: vertical;
    }

    .form__input--select {
        appearance: none;
        cursor: pointer;
    }

    .form__checkbox-label,
    .form__radio-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        font-size: 0.9375rem;
    }

    .form__radio-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .form__help {
        font-size: 0.8125rem;
        margin: 0;
        color: var(--section-text-muted);
    }

    .form__submit {
        align-self: flex-start;
        padding: 0.75rem 2rem;
        background: var(--btn-primary-bg, var(--color-accent, #D4694A));
        color: var(--btn-primary-text);
        border: none;
        border-radius: 0;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.15s;
    }

    .form__submit:hover {
        opacity: 0.85;
    }

    @media (max-width: 767px) {
        .form__submit {
            align-self: stretch;
        }
    }
</style>
