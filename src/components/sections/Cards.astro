---
import type { Section } from "@/types/page";
import RichText from "@components/RichText.astro";

interface Props {
    section: Section;
}

const { section } = Astro.props;
---

<section class="cards-section" data-theme={section.theme}>
    <div class="cards-section__inner">
        {
            (section.title || section.subtitle) && (
                <div class="cards-section__header">
                    {section.subtitle && (
                        <span class="cards-section__eyebrow">
                            {section.subtitle}
                        </span>
                    )}
                    {section.title && (
                        <h2 class="cards-section__title">{section.title}</h2>
                    )}
                    <RichText doc={section.body} />
                </div>
            )
        }
        {
            section.layout === "tech" &&
                section.items &&
                section.items.length > 0 && (
                    <div class="tech-grid">
                        {section.items.map((item) => (
                            <div class="tech-card">
                                {item.icon && item.icon.startsWith("/") && (
                                    <div
                                        class="tech-card__icon-wrap"
                                        aria-hidden="true"
                                    >
                                        <img
                                            src={item.icon}
                                            class="tech-card__icon"
                                            alt=""
                                        />
                                    </div>
                                )}
                                <div class="tech-card__content">
                                    <h3 class="tech-card__title">
                                        {item.title}
                                    </h3>
                                    {item.subtitle && (
                                        <p class="tech-card__subtitle">
                                            {item.subtitle}
                                        </p>
                                    )}
                                </div>
                                {item.ctas && item.ctas.length > 0 && (
                                    <a
                                        href={item.ctas[0].href}
                                        class="tech-card__cta"
                                        target={
                                            item.ctas[0].openInNewTab
                                                ? "_blank"
                                                : undefined
                                        }
                                        rel={
                                            item.ctas[0].openInNewTab
                                                ? "noopener noreferrer"
                                                : undefined
                                        }
                                    >
                                        {item.ctas[0].label} →
                                    </a>
                                )}
                            </div>
                        ))}
                    </div>
                )
        }
        {
            section.layout === "tech" &&
                section.ctas &&
                section.ctas.length > 0 && (
                    <p class="tech-tagline">{section.ctas[0].label}</p>
                )
        }
        {
            section.layout !== "roles" &&
                section.layout !== "tech" &&
                section.items &&
                section.items.length > 0 && (
                    <div class="cards-section__grid">
                        {section.items.map((item) => (
                            <article class="card">
                                {item.mediaUrl && (
                                    <div class="card__media">
                                        <img
                                            src={item.mediaUrl}
                                            alt={item.title ?? ""}
                                            class="card__image"
                                        />
                                    </div>
                                )}
                                <div class="card__body">
                                    {item.icon &&
                                        (item.icon.startsWith("/") ? (
                                            <div
                                                class="card__icon"
                                                aria-hidden="true"
                                            >
                                                <img
                                                    src={item.icon}
                                                    class="card__icon-img"
                                                    width="32"
                                                    height="32"
                                                />
                                            </div>
                                        ) : (
                                            <span
                                                class="card__icon"
                                                aria-hidden="true"
                                            >
                                                {item.icon}
                                            </span>
                                        ))}
                                    {item.title && (
                                        <h3 class="card__title">
                                            {item.title}
                                        </h3>
                                    )}
                                    {item.subtitle && (
                                        <p class="card__subtitle">
                                            {item.subtitle}
                                        </p>
                                    )}
                                    <RichText doc={item.body} />
                                    {item.ctas && item.ctas.length > 0 && (
                                        <div class="card__ctas">
                                            {item.ctas.map((cta) => (
                                                <a
                                                    href={cta.href}
                                                    class={`card__cta card__cta--${cta.variant ?? "ghost"}`}
                                                    target={
                                                        cta.openInNewTab
                                                            ? "_blank"
                                                            : undefined
                                                    }
                                                    rel={
                                                        cta.openInNewTab
                                                            ? "noopener noreferrer"
                                                            : undefined
                                                    }
                                                >
                                                    {cta.label}
                                                </a>
                                            ))}
                                        </div>
                                    )}
                                </div>
                            </article>
                        ))}
                    </div>
                )
        }
        {
            section.layout === "roles" && (
                <div class="cards-section__roles">
                    {section.items?.map((item) => (
                        <div class="role-card">
                            <div class="role-card__title">{item.title}</div>
                            <p class="role-card__subtitle">{item.subtitle}</p>
                            {item.ctas && item.ctas.length > 0 && (
                                <a
                                    href={item.ctas[0].href}
                                    class="role-card__cta"
                                >
                                    {item.ctas[0].label} →
                                </a>
                            )}
                        </div>
                    ))}
                </div>
            )
        }
        {
            section.layout === "roles" &&
                section.ctas &&
                section.ctas.length > 0 && (
                    <div class="cards-section__roles-footer">
                        <p class="cards-section__roles-note">
                            Or speak directly with our team.
                        </p>
                        <a href={section.ctas[0].href} class="btn btn--primary">
                            {section.ctas[0].label}
                        </a>
                    </div>
                )
        }
    </div>
</section>

<style lang="scss">
    .cards-section {
        padding: var(--section-padding-y, 4rem) var(--section-padding-x, 1.5rem);
        background-color: var(--section-bg);
        color: var(--section-text);
    }

    .cards-section__inner {
        max-width: var(--container-width, 1200px);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .cards-section__header {
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .cards-section__eyebrow {
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-accent);
    }

    .cards-section__title {
        font-size: clamp(1.5rem, 3vw, 2.25rem);
        font-weight: 700;
        margin: 0;
    }

    .cards-section__subtitle {
        margin: 0 auto;
        max-width: 60ch;
        color: var(--section-text-muted);
    }

    .cards-section__grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
    }

    @media (min-width: 768px) and (max-width: 900px) {
        .cards-section__grid {
            grid-template-columns: 1fr;
        }
    }

    /* Mobile carousel */
    @media (max-width: 767px) {
        .cards-section__grid {
            display: flex;
            flex-wrap: nowrap;
            align-items: flex-start;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            gap: 1rem;
            /* Bleed right edge so cards peek; left padding stays intact */
            margin-right: calc(-1 * var(--section-padding-x, 1.25rem));
            padding-bottom: 0.75rem;
        }

        .cards-section__grid::-webkit-scrollbar {
            display: none;
        }

        .cards-section__grid .card {
            flex: 0 0 86%;
            scroll-snap-align: start;
        }

        /* Trailing breathing room after last card (padding-right ignored on
           overflow-x flex containers in Chrome/Safari — use margin instead) */
        .cards-section__grid .card:last-child {
            margin-right: var(--section-padding-x, 1.25rem);
        }
    }

    .card {
        border-top: 2px solid var(--color-accent);
        border-inline: 1px solid var(--section-border);
        border-bottom: 1px solid var(--section-border);
        border-radius: 0;
        background-color: var(--section-surface);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition:
            box-shadow 0.2s,
            transform 0.2s;
    }

    .card:hover {
        box-shadow: 0 6px 24px rgba(44, 24, 16, 0.1);
        transform: translateY(-2px);
    }

    .card__media {
        aspect-ratio: 16 / 9;
        overflow: hidden;
    }

    .card__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .card__body {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        flex: 1;
    }

    .card__icon {
        font-size: 2rem;
        width: 4rem;
        height: 4rem;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(212, 105, 74, 0.08);
        border-radius: 0;
        margin-bottom: 0.75rem;
        flex-shrink: 0;
        overflow: hidden;
    }

    .card__icon-img {
        width: 3.25rem;
        height: 3.25rem;
        object-fit: contain;
        transform: scale(2.2);
        filter: brightness(0) invert(0.15);
    }

    [data-theme="dark"] .card__icon-img {
        filter: brightness(0) invert(1);
    }

    .card__title {
        font-size: 1.125rem;
        font-weight: 600;
        margin: 0;
        font-family: var(--font-heading);
    }

    .card__subtitle {
        margin: 0;
        color: var(--section-text-muted);
        font-size: 0.9375rem;
        font-family: var(--font-body);
        font-weight: 300;
    }

    .card__body :global(ul) {
        list-style: none;
        padding: 0;
        margin: 0.5rem 0 0;
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }

    .card__body :global(li) {
        font-size: 0.875rem;
        color: var(--section-text-muted);
        padding-left: 1.25rem;
        position: relative;
        line-height: 1.5;
    }

    .card__body :global(li::before) {
        content: "✓";
        position: absolute;
        left: 0;
        color: var(--color-accent);
        font-weight: 600;
    }

    .card__body :global(h4) {
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--color-accent);
        margin: 1rem 0 0.25rem;
    }

    .card__ctas {
        margin-top: auto;
        padding-top: 1rem;
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .card__cta {
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        color: inherit;
        -webkit-tap-highlight-color: transparent;
        transition: opacity 0.15s;
    }

    .card__cta:active {
        opacity: 0.7;
    }

    .card__cta--ghost {
        color: var(--color-accent);
        text-decoration: none;
        font-weight: 600;
    }

    .card__cta--ghost:hover {
        opacity: 0.8;
    }

    .card__cta--primary {
        padding: 0.5rem 1rem;
        background: var(--color-accent, #D4694A);
        color: var(--btn-primary-text);
        border-radius: 0;
    }

    .card__cta--secondary {
        padding: 0.5rem 1rem;
        border: 1px solid var(--btn-secondary-border);
        color: var(--btn-secondary-text);
        border-radius: 0;
    }

    /* ── Mobile: icon inline with title ───────────────────────────────────── */
    @media (max-width: 767px) {
        /* Switch card body to 2-column grid so icon sits next to title */
        .card__body {
            display: grid;
            grid-template-columns: 1fr auto;
            align-items: start;
            padding-right: 1.5rem;
        }

        /* Icon: right column, row 1 — smaller box */
        .card__icon {
            position: static;
            grid-column: 2;
            grid-row: 1;
            font-size: 1.1rem;
            width: 2.25rem;
            height: 2.25rem;
            align-self: center;
            margin-bottom: 0;
        }

        /* Title: left column, row 1 */
        .card__title {
            grid-column: 1;
            grid-row: 1;
            align-self: center;
        }

        /* Subtitle, rich text, and CTAs span both columns */
        .card__subtitle,
        .card__ctas {
            grid-column: 1 / -1;
        }

        .card__body :global(.rich-text) {
            grid-column: 1 / -1;
        }

        .card__ctas {
            margin-top: 1.25rem;
        }
    }

    // ── Roles layout (Segmented CTA) ─────────────────────────────────────────
    .cards-section__roles {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        margin-top: 3rem;

        @media (max-width: 768px) {
            grid-template-columns: 1fr;
        }
    }

    .role-card {
        border: 1px solid var(--section-border);
        border-radius: 0;
        padding: 2.5rem 2rem;
        text-align: center;
        background: var(--section-surface);
        display: flex;
        flex-direction: column;
        gap: 1rem;

        &__title {
            font-size: 1rem;
            font-weight: 800;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            color: var(--color-accent, #D4694A);
            font-family: var(--font-heading);
        }

        &__subtitle {
            font-size: 0.9rem;
            color: var(--section-text-muted);
            line-height: 1.6;
            margin: 0;
            flex: 1;
        }

        &__cta {
            display: inline-block;
            color: var(--btn-ghost-text);
            text-decoration: none;
            font-weight: 600;
            font-size: 0.875rem;
            transition: opacity 0.15s;

            &:hover {
                opacity: 0.75;
            }
        }
    }

    .cards-section__roles-footer {
        margin-top: 3rem;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
    }

    .cards-section__roles-note {
        font-size: 0.9rem;
        color: var(--section-text-muted);
        margin: 0;
    }

    .btn {
        display: inline-block;
        padding: 0.875rem 2rem;
        border-radius: 0;
        font-weight: 700;
        font-size: 0.9rem;
        text-decoration: none;
        transition: opacity 0.15s;

        &--primary {
            background: var(--btn-primary-bg, #2C1810);
            color: var(--btn-primary-text, #F7F3EC);

            &:hover {
                opacity: 0.85;
            }
        }
    }

    // ── Tech layout ───────────────────────────────────────────────────────────

    .tech-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1.25rem;

        @media (max-width: 900px) {
            grid-template-columns: repeat(3, 1fr);
        }

        @media (max-width: 600px) {
            grid-template-columns: repeat(2, 1fr);
            gap: 0.75rem;
        }

        @media (max-width: 480px) {
            grid-template-columns: 1fr;
        }
    }

    .tech-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding: 2rem 1.25rem 1.5rem;

        @media (max-width: 600px) {
            padding: 1.5rem 1rem 1.25rem;
        }
        background: var(--section-surface);
        border: 1px solid var(--section-border);
        border-radius: 0;
        gap: 0;
        transition:
            border-color 0.2s,
            box-shadow 0.2s;

        &:hover {
            border-color: color-mix(
                in srgb,
                var(--color-accent) 40%,
                transparent
            );
            box-shadow: 0 6px 24px rgba(44, 24, 16, 0.1);
        }

        &__icon-wrap {
            width: 4.5rem;
            height: 4.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 0;
            background: color-mix(
                in srgb,
                var(--color-accent) 10%,
                transparent
            );
            border: 1px solid
                color-mix(in srgb, var(--color-accent) 20%, transparent);
            overflow: hidden;
            flex-shrink: 0;
            margin-bottom: 1.25rem;
        }

        &__icon {
            width: 3.25rem;
            height: 3.25rem;
            object-fit: contain;
            transform: scale(2.2);
            filter: brightness(0) invert(0.15);
        }

        [data-theme="dark"] &__icon {
            filter: brightness(0) invert(1);
        }

        &__content {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            margin-bottom: 1.25rem;
        }

        &__title {
            font-size: 0.8125rem;
            font-weight: 800;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            margin: 0;
            line-height: 1.3;
        }

        &__subtitle {
            font-size: 0.8125rem;
            color: var(--section-text-muted);
            line-height: 1.5;
            margin: 0;
        }

        &__cta {
            display: inline-block;
            font-size: 0.75rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            text-decoration: none;
            color: var(--color-accent);
            padding-top: 1rem;
            border-top: 1px solid var(--section-border);
            width: 100%;
            transition: opacity 0.15s;

            &:hover {
                opacity: 0.75;
            }
        }
    }

    .tech-tagline {
        text-align: center;
        font-size: 0.875rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--section-text-muted);
        margin: 0;
        padding-top: 0.5rem;
    }
</style>
