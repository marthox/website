---
import type { Section } from '@/types/page';
import RichText from '@components/RichText.astro';

interface Props {
    section: Section;
}

const { section } = Astro.props;
---

<section class="cards-section" data-theme={section.theme}>
    <div class="cards-section__inner">
        {(section.title || section.subtitle) && (
            <div class="cards-section__header">
                {section.title && <h2 class="cards-section__title">{section.title}</h2>}
                {section.subtitle && <p class="cards-section__subtitle">{section.subtitle}</p>}
                <RichText doc={section.body} />
            </div>
        )}
        {section.items && section.items.length > 0 && (
            <div class="cards-section__grid">
                {section.items.map(item => (
                    <article class="card">
                        {item.mediaUrl && (
                            <div class="card__media">
                                <img src={item.mediaUrl} alt={item.title ?? ''} class="card__image" />
                            </div>
                        )}
                        <div class="card__body">
                            {item.icon && <span class={`card__icon icon icon--${item.icon}`} aria-hidden="true" />}
                            {item.title && <h3 class="card__title">{item.title}</h3>}
                            {item.subtitle && <p class="card__subtitle">{item.subtitle}</p>}
                            <RichText doc={item.body} />
                            {item.ctas && item.ctas.length > 0 && (
                                <div class="card__ctas">
                                    {item.ctas.map(cta => (
                                        <a
                                            href={cta.href}
                                            class={`card__cta card__cta--${cta.variant ?? 'ghost'}`}
                                            target={cta.openInNewTab ? '_blank' : undefined}
                                            rel={cta.openInNewTab ? 'noopener noreferrer' : undefined}
                                        >
                                            {cta.label}
                                        </a>
                                    ))}
                                </div>
                            )}
                        </div>
                    </article>
                ))}
            </div>
        )}
    </div>
</section>

<style>
    .cards-section {
        padding: var(--section-padding-y, 4rem) var(--section-padding-x, 1.5rem);
        background-color: var(--section-bg);
        color: var(--section-text);
    }

    .cards-section__inner {
        max-width: var(--container-width, 1200px);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .cards-section__header {
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .cards-section__title {
        font-size: clamp(1.5rem, 3vw, 2.25rem);
        font-weight: 700;
        margin: 0;
    }

    .cards-section__subtitle {
        margin: 0 auto;
        max-width: 60ch;
        color: var(--section-text-muted);
    }

    .cards-section__grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
        gap: 1.5rem;
    }

    .card {
        border: 1px solid var(--section-border);
        border-radius: var(--radius-lg, 0.5rem);
        background-color: var(--section-surface);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .card__media {
        aspect-ratio: 16 / 9;
        overflow: hidden;
    }

    .card__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .card__body {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        flex: 1;
    }

    .card__icon {
        font-size: 1.5rem;
    }

    .card__title {
        font-size: 1.125rem;
        font-weight: 600;
        margin: 0;
    }

    .card__subtitle {
        margin: 0;
        color: var(--section-text-muted);
        font-size: 0.9375rem;
    }

    .card__ctas {
        margin-top: auto;
        padding-top: 1rem;
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .card__cta {
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
    }

    .card__cta--ghost {
        text-decoration: underline;
    }

    .card__cta--primary {
        padding: 0.5rem 1rem;
        background-color: var(--btn-primary-bg);
        color: var(--btn-primary-text);
        border-radius: 0.25rem;
    }

    .card__cta--secondary {
        padding: 0.5rem 1rem;
        border: 1px solid var(--btn-secondary-border);
        color: var(--btn-secondary-text);
        border-radius: 0.25rem;
    }
</style>
