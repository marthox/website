---
import type { Section } from '@/types/page';
import FormRenderer from '@components/FormRenderer.astro';
import RichText from '@components/RichText.astro';

interface Props {
    section: Section;
}

const { section } = Astro.props;

const isSplit      = section.layout === 'split' && section.form;
const isLeft       = section.layout === 'left';
const isComparison = section.layout === 'comparison';
---

{isComparison ? (
    <section class="text-section text-section--comparison" data-theme={section.theme}>
        <div class="text-section--comparison__inner">
            <RichText doc={section.body} />
        </div>
    </section>
) : (
    <section
        class={`text-section ${isSplit ? 'text-section--split' : ''} ${isLeft ? 'text-section--left' : ''}`}
        data-theme={section.theme}
    >
        <div class="text-section__inner">
            <div class="text-section__content">
                {section.subtitle && <span class="text-section__eyebrow">{section.subtitle}</span>}
                {section.title && <h2 class="text-section__title">{section.title}</h2>}
                {!isLeft && <RichText doc={section.body} />}
                {section.ctas && section.ctas.length > 0 && (
                    <div class="text-section__ctas">
                        {section.ctas.map(cta => (
                            <a
                                href={cta.href}
                                class={`text-section__cta text-section__cta--${cta.variant ?? 'primary'}`}
                                target={cta.openInNewTab ? '_blank' : undefined}
                                rel={cta.openInNewTab ? 'noopener noreferrer' : undefined}
                            >
                                {cta.label}
                            </a>
                        ))}
                    </div>
                )}
            </div>
            {isLeft && (
                <div class="text-section__body-col">
                    <RichText doc={section.body} />
                </div>
            )}
            {section.form && (
                <div class="text-section__form">
                    <FormRenderer form={section.form} />
                </div>
            )}
            {isLeft && (
                <div class="text-section__globe" aria-hidden="true">
                    <svg viewBox="0 0 300 300" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                            <clipPath id="globe-clip">
                                <circle cx="150" cy="150" r="145"/>
                            </clipPath>
                            <radialGradient id="sphere-glow" cx="38%" cy="32%" r="55%">
                                <stop offset="0%" stop-color="#00CFFF" stop-opacity="0.15"/>
                                <stop offset="100%" stop-color="#00CFFF" stop-opacity="0"/>
                            </radialGradient>
                        </defs>

                        <!-- Sphere ambient glow -->
                        <circle cx="150" cy="150" r="145" fill="url(#sphere-glow)"/>

                        <!-- Latitude lines — clipped to globe -->
                        <g clip-path="url(#globe-clip)" stroke="#00CFFF" stroke-width="0.6" fill="none" opacity="0.35">
                            <ellipse cx="150" cy="24"  rx="72"  ry="9"/>
                            <ellipse cx="150" cy="78"  rx="126" ry="14"/>
                            <ellipse cx="150" cy="150" rx="145" ry="17"/>
                            <ellipse cx="150" cy="222" rx="126" ry="14"/>
                            <ellipse cx="150" cy="276" rx="72"  ry="9"/>
                        </g>

                        <!-- Longitude lines — clipped to globe -->
                        <g clip-path="url(#globe-clip)" stroke="#00CFFF" stroke-width="0.6" fill="none" opacity="0.35">
                            <line x1="150" y1="5"  x2="150" y2="295"/>
                            <ellipse cx="150" cy="150" rx="72"  ry="145"/>
                            <ellipse cx="150" cy="150" rx="126" ry="145"/>
                        </g>

                        <!-- Globe outline -->
                        <circle cx="150" cy="150" r="145" stroke="#00CFFF" stroke-width="1" opacity="0.5"/>

                        <!-- US location marker (~38°N, 97°W — λ=−7° from −90°W center) -->
                        <circle cx="132" cy="61" r="3.5" fill="#00CFFF" opacity="0.95"/>
                        <circle cx="132" cy="61" r="7"   stroke="#00CFFF" stroke-width="1"   fill="none" class="globe-ping"/>
                        <circle cx="132" cy="61" r="11"  stroke="#00CFFF" stroke-width="0.5" fill="none" class="globe-ping globe-ping--delay"/>
                        <text x="142" y="59" font-size="7.5" fill="#00CFFF" font-family="monospace" letter-spacing="1.8" opacity="0.85">US</text>

                        <!-- LATAM location marker (~15°S, 60°W — λ=+30° from −90°W center) -->
                        <circle cx="222" cy="188" r="3.5" fill="#00CFFF" opacity="0.95"/>
                        <circle cx="222" cy="188" r="7"   stroke="#00CFFF" stroke-width="1"   fill="none" class="globe-ping globe-ping--offset"/>
                        <circle cx="222" cy="188" r="11"  stroke="#00CFFF" stroke-width="0.5" fill="none" class="globe-ping globe-ping--delay globe-ping--offset"/>
                        <text x="232" y="186" font-size="7.5" fill="#00CFFF" font-family="monospace" letter-spacing="1.8" opacity="0.85">LATAM</text>

                        <!-- Connector arc between US and LATAM -->
                        <path d="M 132 64 Q 200 130 222 185" stroke="#00CFFF" stroke-width="0.75" stroke-dasharray="3 4" fill="none" opacity="0.3"/>
                    </svg>
                </div>
            )}
        </div>
    </section>
)}

<style>
    /* ── Base text section ──────────────────────────────────────────────── */
    .text-section {
        padding: var(--section-padding-y, 4rem) var(--section-padding-x, 1.5rem);
        background-color: var(--section-bg);
        color: var(--section-text);
    }

    .text-section__inner {
        max-width: var(--container-width, 1200px);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .text-section--split .text-section__inner {
        flex-direction: row;
        align-items: flex-start;
    }

    .text-section__content {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        flex: 1;
    }

    .text-section__title {
        font-size: clamp(1.5rem, 3vw, 2.25rem);
        font-weight: 700;
        margin: 0;
        font-family: var(--font-heading);
        color: var(--section-text);
        line-height: 1.15;
    }

    .text-section__eyebrow {
        font-size: 0.75rem;
        font-weight: 400;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--color-accent);
        font-family: var(--font-body);
    }

    .text-section__ctas {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .text-section__cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.625rem 1.5rem;
        border-radius: 0;
        font-weight: 600;
        text-decoration: none;
        transition: opacity 0.15s;
        font-family: var(--font-body);
        font-size: 0.75rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
    }

    .text-section__cta:hover { opacity: 0.85; }

    .text-section__cta--primary {
        background: var(--btn-primary-bg, #2C1810);
        color: var(--btn-primary-text, #F7F3EC);
    }

    .text-section__cta--secondary {
        border: 2px solid var(--btn-secondary-border);
        color: var(--btn-secondary-text);
    }

    .text-section__cta--ghost {
        color: var(--btn-ghost-text);
        text-decoration: underline;
    }

    .text-section__form { flex: 1; }

    /* ── Left (two-column) layout ───────────────────────────────────────── */
    .text-section--left {
        position: relative;
        overflow: hidden;
    }

    .text-section--left .text-section__inner {
        flex-direction: row;
        align-items: flex-start;
        gap: 4rem;
        position: relative;
        z-index: 1;
    }

    .text-section--left .text-section__content {
        flex: 0 0 40%;
        border-left: 3px solid var(--color-accent);
        padding-left: 1.5rem;
    }

    .text-section--left .text-section__body-col { flex: 1; }

    /* ── Globe decoration ───────────────────────────────────────────────── */
    .text-section__globe {
        position: absolute;
        right: -80px;
        top: 50%;
        transform: translateY(-50%);
        width: 420px;
        height: 420px;
        opacity: 0.13;
        pointer-events: none;
        z-index: 0;
    }

    .text-section__globe svg {
        width: 100%;
        height: 100%;
    }

    /* Pulse rings on location markers */
    @keyframes globe-pulse {
        0%   { opacity: 0.75; transform: scale(1); }
        100% { opacity: 0;    transform: scale(1.7); }
    }

    .globe-ping {
        transform-box: fill-box;
        transform-origin: center;
        animation: globe-pulse 2.4s ease-out infinite;
    }

    .globe-ping--delay  { animation-delay: 0.9s; }
    .globe-ping--offset { animation-delay: 1.2s; }
    .globe-ping--delay.globe-ping--offset { animation-delay: 2.1s; }

    /* ── Comparison layout ──────────────────────────────────────────────── */
    .text-section--comparison {
        padding: 0 var(--section-padding-x, 1.5rem) var(--section-padding-y, 4rem);
        background-color: var(--section-bg);
        color: var(--section-text);
    }

    .text-section--comparison__inner {
        max-width: var(--container-width, 1200px);
        margin: 0 auto;
        border-top: 1px solid var(--section-border);
        padding-top: 3rem;
    }

    /* Label paragraph — only direct p children of .rich-text, not li > p */
    :global(.text-section--comparison .rich-text > p) {
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--section-text-muted);
        margin: 0 0 2rem;
        text-align: center;
    }

    /* Three-column comparison grid — full path beats RichText specificity */
    :global(.text-section--comparison .rich-text ul) {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 2rem;
    }

    :global(.text-section--comparison .rich-text li) {
        border-top: 2px solid var(--color-accent, #00CFFF);
        padding: 1.25rem 0 0;
        margin: 0;
        position: relative;
    }

    /* Reset p inside li — no uppercase, normal body text */
    :global(.text-section--comparison .rich-text li p) {
        margin: 0;
        font-size: 0.9375rem;
        line-height: 1.65;
        color: var(--section-text);
        text-transform: none;
        letter-spacing: 0;
        font-weight: 400;
    }

    /* ── Responsive ─────────────────────────────────────────────────────── */
    @media (max-width: 767px) {
        .text-section--split .text-section__inner {
            flex-direction: column;
        }

        .text-section--left .text-section__inner {
            flex-direction: column;
        }

        .text-section--left .text-section__content {
            border-left: none;
            padding-left: 0;
            border-top: 3px solid var(--color-accent);
            padding-top: 1rem;
        }

        .text-section__globe {
            width: 280px;
            height: 280px;
            right: -60px;
            opacity: 0.08;
        }

        :global(.text-section--comparison .rich-text ul) {
            grid-template-columns: 1fr;
            gap: 1.5rem;
        }

        :global(.text-section--comparison .rich-text > p) {
            text-align: left;
        }
    }
</style>
