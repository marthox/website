---
import type { Section } from '@/types/page';
import RichText from '@components/RichText.astro';

interface Props {
    section: Section;
}

const { section } = Astro.props;
---

<section class="gallery" data-theme={section.theme}>
    <div class="gallery__inner">
        {(section.title || section.subtitle) && (
            <div class="gallery__header">
                {section.title && <h2 class="gallery__title">{section.title}</h2>}
                {section.subtitle && <p class="gallery__subtitle">{section.subtitle}</p>}
                <RichText doc={section.body} />
            </div>
        )}
        {section.items && section.items.length > 0 && (
            <div class="gallery__grid">
                {section.items.map(item => (
                    item.mediaUrl && (
                        <figure class="gallery__item">
                            <img
                                src={item.mediaUrl}
                                alt={item.title ?? ''}
                                class="gallery__image"
                                loading="lazy"
                            />
                            {item.title && (
                                <figcaption class="gallery__caption">{item.title}</figcaption>
                            )}
                        </figure>
                    )
                ))}
            </div>
        )}
    </div>
</section>

<style>
    .gallery {
        padding: var(--section-padding-y, 4rem) var(--section-padding-x, 1.5rem);
        background-color: var(--section-bg);
        color: var(--section-text);
    }

    .gallery__inner {
        max-width: var(--container-width, 1200px);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .gallery__header {
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .gallery__title {
        font-size: clamp(1.5rem, 3vw, 2.25rem);
        font-weight: 700;
        margin: 0;
    }

    .gallery__subtitle {
        margin: 0 auto;
        max-width: 60ch;
        color: var(--section-text-muted);
    }

    .gallery__grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 16rem), 1fr));
        gap: 1rem;
    }

    .gallery__item {
        margin: 0;
        overflow: hidden;
        border-radius: 0.375rem;
    }

    .gallery__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        aspect-ratio: 4 / 3;
        display: block;
        transition: transform 0.3s ease;
    }

    .gallery__item:hover .gallery__image {
        transform: scale(1.03);
    }

    .gallery__caption {
        padding: 0.5rem 0;
        font-size: 0.875rem;
        color: var(--section-text-muted);
    }
</style>
