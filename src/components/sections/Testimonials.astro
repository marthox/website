---
import type { Section } from '@/types/page';

interface Props {
    section: Section;
}

const { section } = Astro.props;
---

<section class="testimonials" data-theme={section.theme}>
    <div class="testimonials__inner">
        {(section.title || section.subtitle) && (
            <div class="testimonials__header">
                {section.title && <h2 class="testimonials__title">{section.title}</h2>}
                {section.subtitle && <p class="testimonials__subtitle">{section.subtitle}</p>}
            </div>
        )}
        {section.items && section.items.length > 0 && (
            <div class="testimonials__grid">
                {section.items.map(item => (
                    <blockquote class="testimonial">
                        {item.mediaUrl && (
                            <img
                                src={item.mediaUrl}
                                alt={item.title ?? ''}
                                class="testimonial__avatar"
                            />
                        )}
                        {item.icon && !item.mediaUrl && (
                            <span class={`testimonial__icon icon icon--${item.icon}`} aria-hidden="true" />
                        )}
                        <div class="testimonial__content">
                            {item.subtitle && <p class="testimonial__quote">{item.subtitle}</p>}
                            {item.title && (
                                <footer class="testimonial__author">
                                    <strong>{item.title}</strong>
                                    {item.value && <span class="testimonial__role">, {item.value}</span>}
                                </footer>
                            )}
                        </div>
                    </blockquote>
                ))}
            </div>
        )}
    </div>
</section>

<style>
    .testimonials {
        padding: var(--section-padding-y, 4rem) var(--section-padding-x, 1.5rem);
        background-color: var(--section-bg);
        color: var(--section-text);
    }

    .testimonials__inner {
        max-width: var(--container-width, 1200px);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .testimonials__header {
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .testimonials__title {
        font-size: clamp(1.5rem, 3vw, 2.25rem);
        font-weight: 700;
        margin: 0;
    }

    .testimonials__subtitle {
        margin: 0 auto;
        max-width: 60ch;
        color: var(--section-text-muted);
    }

    .testimonials__grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 22rem), 1fr));
        gap: 1.5rem;
    }

    .testimonial {
        margin: 0;
        padding: 1.75rem;
        border: 1px solid var(--section-border);
        border-radius: var(--radius-lg, 0.5rem);
        background-color: var(--section-surface);
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .testimonial__avatar {
        width: 3rem;
        height: 3rem;
        border-radius: 50%;
        object-fit: cover;
    }

    .testimonial__icon {
        font-size: 2rem;
    }

    .testimonial__content {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .testimonial__quote {
        margin: 0;
        font-size: 1rem;
        line-height: 1.7;
        font-style: italic;
    }

    .testimonial__author {
        font-size: 0.875rem;
    }

    .testimonial__role {
        color: var(--section-text-muted);
    }
</style>
