---
import type { Form } from '@/types/page';
import FormRenderer from '@components/FormRenderer.astro';

interface Props {
    form: Form;
}

const { form } = Astro.props;
---

<section class="standalone-form" data-theme={form.theme}>
    <div class="standalone-form__inner">
        <FormRenderer form={form} />
    </div>
</section>

<style>
    .standalone-form {
        padding: var(--section-padding-y, 4rem) var(--section-padding-x, 1.5rem);
        background-color: var(--section-bg);
        color: var(--section-text);
    }

    .standalone-form__inner {
        max-width: 48rem;
        margin: 0 auto;
    }

    .standalone-form :global(.form__title) {
        font-size: 2rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 0.5rem;
    }

    .standalone-form :global(.form__subtitle) {
        color: var(--section-text-muted);
        text-align: center;
        margin-bottom: 2rem;
    }

    .standalone-form[data-theme="dark"] :global(input),
    .standalone-form[data-theme="dark"] :global(textarea),
    .standalone-form[data-theme="dark"] :global(select) {
        background-color: var(--section-surface);
        border-color: var(--section-border);
        color: var(--section-text);
    }

    .standalone-form :global(button[type="submit"]) {
        background: var(--gradient-brand);
        color: #FFFFFF;
        border: none;
        border-radius: var(--radius-pill, 50px);
        padding: 0.75rem 2rem;
        font-weight: 600;
        cursor: pointer;
        font-size: 1rem;
        transition: opacity 0.15s;
    }

    .standalone-form :global(button[type="submit"]):hover {
        opacity: 0.88;
    }
</style>
