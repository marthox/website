---
import type { Form } from '@/types/page';
import FormRenderer from '@components/FormRenderer.astro';

interface Props {
    form: Form;
}

const { form } = Astro.props;
---

<section class="standalone-form" data-theme={form.theme}>
    <div class="standalone-form__inner">
        <FormRenderer form={form} />
    </div>
</section>

<style>
    .standalone-form {
        padding: var(--section-padding-y, 4rem) var(--section-padding-x, 1.5rem);
        background-color: var(--section-bg);
        color: var(--section-text);
    }

    .standalone-form__inner {
        max-width: 48rem;
        margin: 0 auto;
    }

    .standalone-form :global(.form__title) {
        font-size: 2rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 0.5rem;
        font-family: var(--font-heading);
    }

    .standalone-form :global(.form__subtitle) {
        color: var(--section-text-muted);
        text-align: center;
        margin-bottom: 2rem;
    }

    .standalone-form :global(input),
    .standalone-form :global(textarea),
    .standalone-form :global(select) {
        background: var(--color-surface, #FDFAF4);
        border: 1px solid var(--color-border, #D4C9B0);
        border-radius: 0;
        font-family: var(--font-body);
        font-weight: 300;
        color: var(--section-text);
    }

    .standalone-form :global(input:focus),
    .standalone-form :global(textarea:focus),
    .standalone-form :global(select:focus) {
        border-color: var(--color-accent, #D4694A);
        outline: none;
    }

    .standalone-form[data-theme="dark"] :global(input),
    .standalone-form[data-theme="dark"] :global(textarea),
    .standalone-form[data-theme="dark"] :global(select) {
        background-color: var(--section-surface);
        border-color: var(--section-border);
        color: var(--section-text);
    }

    .standalone-form :global(button[type="submit"]) {
        background: var(--btn-primary-bg, #2C1810);
        color: var(--btn-primary-text, #F7F3EC);
        border: none;
        border-radius: 0;
        padding: 0.75rem 2rem;
        font-family: var(--font-body);
        font-size: 0.75rem;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        font-weight: 400;
        cursor: pointer;
        transition: background 0.15s;
    }

    .standalone-form :global(button[type="submit"]):hover {
        background: var(--color-accent, #D4694A);
    }
</style>
