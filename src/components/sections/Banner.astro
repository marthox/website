---
import type { Section } from '@/types/page';
import RichText from '@components/RichText.astro';

interface Props {
    section: Section;
}

const { section } = Astro.props;
---

<section class="banner" data-theme={section.theme}>
    <div class="banner__inner">
        <div class="banner__text">
            {section.title && <h2 class="banner__title">{section.title}</h2>}
            {section.subtitle && <p class="banner__subtitle">{section.subtitle}</p>}
            <RichText doc={section.body} />
        </div>
        {section.ctas && section.ctas.length > 0 && (
            <div class="banner__ctas">
                {section.ctas.map(cta => (
                    <a
                        href={cta.href}
                        class={`banner__cta banner__cta--${cta.variant ?? 'primary'}`}
                        target={cta.openInNewTab ? '_blank' : undefined}
                        rel={cta.openInNewTab ? 'noopener noreferrer' : undefined}
                    >
                        {cta.icon && <span class={`icon icon--${cta.icon}`} aria-hidden="true" />}
                        {cta.label}
                    </a>
                ))}
            </div>
        )}
    </div>
</section>

<style>
    .banner {
        padding: 2.5rem var(--section-padding-x, 1.5rem);
        background-color: var(--section-bg);
        color: var(--section-text);
    }

    .banner__inner {
        max-width: var(--container-width, 1200px);
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        flex-wrap: wrap;
    }

    .banner__text {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .banner__title {
        font-size: 1.5rem;
        font-weight: 700;
        margin: 0;
    }

    .banner__subtitle {
        margin: 0;
        color: var(--section-text-muted);
    }

    .banner__ctas {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        flex-shrink: 0;
    }

    .banner__cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.625rem 1.5rem;
        border-radius: var(--radius-md, 0.375rem);
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: opacity 0.15s;
    }

    .banner__cta:hover {
        opacity: 0.85;
    }

    .banner__cta--primary {
        background-color: var(--btn-primary-bg);
        color: var(--btn-primary-text);
    }

    .banner__cta--secondary {
        border: 2px solid var(--btn-secondary-border);
        color: var(--btn-secondary-text);
    }

    .banner__cta--ghost {
        color: var(--btn-ghost-text);
        text-decoration: underline;
    }

    @media (max-width: 767px) {
        .banner__inner {
            flex-direction: column;
            align-items: flex-start;
        }
    }
</style>
