---
import type { Section } from '@/types/page';
import RichText from '@components/RichText.astro';

interface Props {
    section: Section;
}

const { section } = Astro.props;

const isLeft = section.layout === 'left';
const layoutClass = isLeft ? 'hero--left'
    : section.layout === 'right' ? 'hero--right'
    : section.layout === 'split' ? 'hero--split'
    : 'hero--center';
---

<section class={`hero ${layoutClass}`} data-theme={section.theme}>
    <div class="hero__inner">
        <div class="hero__content">
            {section.subtitle && !isLeft && (
                <span class="hero__eyebrow">{section.subtitle}</span>
            )}
            {section.title && <h1 class="hero__title" set:html={section.title} />}
            <RichText doc={section.body} />
            {section.ctas && section.ctas.length > 0 && (
                <div class="hero__ctas">
                    {section.ctas.map(cta => (
                        <a
                            href={cta.href}
                            class={`hero__cta hero__cta--${cta.variant ?? 'primary'}`}
                            target={cta.openInNewTab ? '_blank' : undefined}
                            rel={cta.openInNewTab ? 'noopener noreferrer' : undefined}
                        >
                            {cta.icon && <span aria-hidden="true">{cta.icon}</span>}
                            {cta.label}
                        </a>
                    ))}
                </div>
            )}
            {isLeft && (
                <div class="hero__stats" aria-label="Key metrics">
                    <div class="hero__stat">
                        <span class="hero__stat-value">$4.8M+</span>
                        <span class="hero__stat-label">Monthly Revenue</span>
                    </div>
                    <div class="hero__stat">
                        <span class="hero__stat-value">12K+</span>
                        <span class="hero__stat-label">Daily Calls Routed</span>
                    </div>
                    <div class="hero__stat">
                        <span class="hero__stat-value">2.4ms</span>
                        <span class="hero__stat-label">Avg. Decisioning</span>
                    </div>
                    <div class="hero__stat">
                        <span class="hero__stat-value">+3B</span>
                        <span class="hero__stat-label">Monthly Impacts</span>
                    </div>
                </div>
            )}
        </div>

        {/* Floating dashboard cards — decorative, desktop only */}
        {isLeft && (
            <div class="hero__dashboard" aria-hidden="true">
                {/* Revenue Pipeline card */}
                <div class="hero__dash-card hero__dash-card--revenue">
                    <div class="hero__dash-header">
                        <span class="hero__dash-label">REVENUE PIPELINE</span>
                        <span class="hero__dash-live">● Live</span>
                    </div>
                    <div class="hero__dash-value">$4,821,390</div>
                    <div class="hero__dash-delta">↑ +34.2% <span>vs last month</span></div>
                    <div class="hero__dash-bars">
                        <div class="hero__dash-bar-row">
                            <span>Affilia Network</span>
                            <span class="hero__dash-pct" style="color:#ff0087">72%</span>
                        </div>
                        <div class="hero__dash-bar"><div style="width:72%;background:#ff0087"></div></div>
                        <div class="hero__dash-bar-row">
                            <span>Pay Per Call</span>
                            <span class="hero__dash-pct" style="color:#0099ff">55%</span>
                        </div>
                        <div class="hero__dash-bar"><div style="width:55%;background:#0099ff"></div></div>
                        <div class="hero__dash-bar-row">
                            <span>Ping Post</span>
                            <span class="hero__dash-pct" style="color:#ff0087">88%</span>
                        </div>
                        <div class="hero__dash-bar"><div style="width:88%;background:#ff0087"></div></div>
                    </div>
                </div>

                {/* Inbound Call card */}
                <div class="hero__dash-card hero__dash-card--calls">
                    <div class="hero__dash-mini-header">
                        <img src="/icons/Pay per call.svg" class="hero__dash-mini-icon hero__dash-mini-icon--img" width="20" height="20" aria-hidden="true" />
                        <div>
                            <div class="hero__dash-mini-title">
                                Inbound Call
                                <span class="hero__dash-live-dot"></span>
                            </div>
                            <div class="hero__dash-mini-sub">High Intent</div>
                        </div>
                    </div>
                    <div class="hero__dash-value hero__dash-value--sm">12,847</div>
                    <div class="hero__dash-mini-desc">Calls routed today</div>
                </div>

                {/* Ping Post card */}
                <div class="hero__dash-card hero__dash-card--ping">
                    <div class="hero__dash-mini-header">
                        <img src="/icons/ping post.svg" class="hero__dash-mini-icon hero__dash-mini-icon--img hero__dash-mini-icon--blue" width="20" height="20" aria-hidden="true" />
                        <div class="hero__dash-mini-title">Ping Post</div>
                    </div>
                    <div class="hero__dash-value hero__dash-value--sm">2.4ms</div>
                    <div class="hero__dash-mini-desc">Avg. decisioning</div>
                </div>
            </div>
        )}

        {section.mediaUrl && !isLeft && (
            <div class="hero__media">
                <img src={section.mediaUrl} alt={section.title ?? ''} class="hero__image" />
            </div>
        )}
    </div>

    <div class="hero__scroll-arrow" aria-hidden="true">↓</div>
</section>

<style>
    /* ── Base ────────────────────────────────────────────────────────────────── */
    .hero {
        padding: var(--section-padding-y, 5rem) var(--section-padding-x, 1.5rem);
        background-color: var(--section-bg);
        color: var(--section-text);
        position: relative;
    }

    .hero[data-theme="dark"] {
        background: var(--gradient-hero-dark);
        min-height: calc(100svh - var(--nav-height, 0px));
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
    }

    /* Subtle radial glow */
    .hero[data-theme="dark"]::before {
        content: '';
        position: absolute;
        top: -20%;
        left: -10%;
        width: 70%;
        height: 80%;
        background: radial-gradient(ellipse, rgba(0,153,255,0.06) 0%, transparent 65%);
        pointer-events: none;
        z-index: 0;
    }

    /* Subtle grid texture */
    .hero[data-theme="dark"]::after {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
            linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
            linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
        background-size: 64px 64px;
        pointer-events: none;
        z-index: 0;
    }

    .hero__inner {
        width: 100%;
        max-width: var(--container-width, 1200px);
        margin: 0 auto;
        display: flex;
        gap: 3rem;
        align-items: center;
        position: relative;
        z-index: 1;
    }

    /* ── Center variant ────────────────────────────────────────────────────── */
    .hero--center .hero__inner {
        flex-direction: column;
        text-align: center;
    }

    .hero--center .hero__ctas { justify-content: center; }

    /* ── Left variant (primary variant matching reference) ─────────────────── */
    .hero--left .hero__inner {
        flex-direction: row;
        align-items: center;
    }

    .hero--left .hero__content {
        flex: 0 0 52%;
        max-width: 52%;
    }

    /* ── Other variants ────────────────────────────────────────────────────── */
    .hero--right .hero__inner  { flex-direction: row-reverse; }
    .hero--split .hero__inner  { flex-direction: row; justify-content: space-between; }

    /* ── Content ────────────────────────────────────────────────────────────── */
    .hero__content {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
        flex: 1;
    }

    /* Simple eyebrow (center layout) */
    .hero__eyebrow {
        font-size: 0.8125rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--color-accent);
    }

    /* Title */
    .hero__title {
        font-size: clamp(2.25rem, 5.5vw, 4rem);
        font-weight: 900;
        line-height: 1.05;
        letter-spacing: -0.02em;
        margin: 0;
    }

    .hero--left .hero__title {
        font-size: clamp(2.25rem, 5.5vw, 4rem);
    }

    /* Accent word in title — gradient text handled globally via .accent class */

    /* Body text */
    .hero__content :global(p) {
        font-size: clamp(1rem, 1.5vw, 1.125rem);
        color: var(--section-text-muted);
        max-width: 52ch;
        margin: 0;
        line-height: 1.65;
    }

    /* Highlight linked words in body (reference style) — excludes CTA buttons */
    .hero__content :global(a:not(.hero__cta)) {
        color: var(--color-accent);
        text-decoration: none;
        font-weight: 600;
    }

    /* CTA row */
    .hero__ctas {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 0.25rem;
    }

    .hero__cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.8rem 1.75rem;
        border-radius: var(--radius-pill);
        font-weight: 600;
        font-size: 0.9375rem;
        text-decoration: none;
        transition: transform 0.15s, box-shadow 0.15s, opacity 0.15s;
        letter-spacing: 0.01em;
    }

    .hero__cta:hover { transform: translateY(-1px); }

    .hero__cta--primary {
        background: var(--gradient-brand, linear-gradient(135deg, #0099ff 0%, #ff0087 100%));
        color: #FFFFFF;
        box-shadow: 0 4px 24px rgba(255, 0, 135, 0.3);
    }

    .hero__cta--primary:hover {
        box-shadow: 0 6px 32px rgba(255, 0, 135, 0.5);
        opacity: 0.92;
    }

    .hero__cta--secondary {
        border: 1.5px solid rgba(123,201,245,0.35);
        color: #7bc9f5;
        background: rgba(0,153,255,0.05);
        backdrop-filter: blur(4px);
    }

    .hero__cta--secondary:hover { border-color: rgba(123,201,245,0.7); }

    .hero__cta--ghost {
        color: var(--color-accent);
        text-decoration: underline;
        padding-inline: 0;
    }

    /* ── Stats row ──────────────────────────────────────────────────────────── */
    .hero__stats {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding-top: 0.5rem;
        border-top: 1px solid rgba(255,255,255,0.07);
        margin-top: 0.25rem;
    }

    .hero__stat {
        display: flex;
        flex-direction: column;
        gap: 0.15rem;
    }

    .hero__stat-value {
        font-size: 1.375rem;
        font-weight: 800;
        font-family: var(--font-heading);
        color: #F4F4EE;
        letter-spacing: -0.02em;
    }

    .hero__stat-label {
        font-size: 0.75rem;
        color: rgba(123,201,245,0.7);
        letter-spacing: 0.01em;
    }

    .hero__stat-sep {
        width: 1px;
        height: 2rem;
        background: rgba(255,255,255,0.1);
        flex-shrink: 0;
    }

    /* ── Dashboard cards (decorative) ──────────────────────────────────────── */
    .hero__dashboard {
        flex: 0 0 44%;
        max-width: 44%;
        position: relative;
        height: 380px;
    }

    .hero__dash-card {
        position: absolute;
        background: rgba(6, 10, 28, 0.92);
        border: 1px solid rgba(255,255,255,0.09);
        border-radius: 1rem;
        backdrop-filter: blur(20px);
        box-shadow: 0 24px 60px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.04) inset;
        color: #F4F4EE;
        font-family: var(--font-body);
        animation: card-float 6s ease-in-out infinite;
    }

    .hero__dash-card--revenue { animation-delay: 0s; }
    .hero__dash-card--calls   { animation-delay: -2s; }
    .hero__dash-card--ping    { animation-delay: -4s; }

    @keyframes card-float {
        0%, 100% { transform: translateY(0px); }
        50%       { transform: translateY(-10px); }
    }

    /* Revenue Pipeline — large card, top right */
    .hero__dash-card--revenue {
        top: 0;
        right: 0;
        width: 260px;
        padding: 1.25rem;
    }

    .hero__dash-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.5rem;
    }

    .hero__dash-label {
        font-size: 0.6875rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        color: rgba(123,201,245,0.7);
        text-transform: uppercase;
    }

    .hero__dash-live {
        font-size: 0.6875rem;
        font-weight: 700;
        color: #0099ff;
        letter-spacing: 0.05em;
    }

    .hero__dash-value {
        font-size: 1.625rem;
        font-weight: 800;
        font-family: var(--font-heading);
        letter-spacing: -0.02em;
        line-height: 1;
        margin-bottom: 0.25rem;
    }

    .hero__dash-value--sm {
        font-size: 1.375rem;
    }

    .hero__dash-delta {
        font-size: 0.8125rem;
        font-weight: 600;
        color: #22C55E;
        margin-bottom: 1rem;
    }

    .hero__dash-delta span {
        color: rgba(123,201,245,0.6);
        font-weight: 400;
        margin-left: 0.25rem;
    }

    .hero__dash-bars { display: flex; flex-direction: column; gap: 0.35rem; }

    .hero__dash-bar-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.75rem;
        color: rgba(123,201,245,0.7);
        margin-bottom: 0.1rem;
    }

    .hero__dash-pct { font-weight: 700; }

    .hero__dash-bar {
        height: 4px;
        background: rgba(255,255,255,0.07);
        border-radius: 2px;
        overflow: hidden;
        margin-bottom: 0.35rem;
    }

    .hero__dash-bar div {
        height: 100%;
        border-radius: 2px;
        transition: width 1s ease;
    }

    /* Inbound Call — small card, middle left */
    .hero__dash-card--calls {
        bottom: 110px;
        left: 80px;
        width: 175px;
        padding: 1rem;
    }

    /* Ping Post — small card, bottom right */
    .hero__dash-card--ping {
        bottom: 0;
        right: 40px;
        width: 160px;
        padding: 1rem;
    }

    .hero__dash-mini-header {
        display: flex;
        align-items: flex-start;
        gap: 0.625rem;
        margin-bottom: 0.625rem;
    }

    .hero__dash-mini-icon {
        width: 2rem;
        height: 2rem;
        border-radius: 0.5rem;
        background: rgba(255,0,135,0.12);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.875rem;
        flex-shrink: 0;
    }

    .hero__dash-mini-icon--blue {
        background: rgba(0,153,255,0.12);
    }

    .hero__dash-mini-icon--img {
        padding: 0.3rem;
        object-fit: contain;
        filter: brightness(0) invert(1);
    }

    .hero__dash-mini-title {
        font-size: 0.8125rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }

    .hero__dash-mini-sub {
        font-size: 0.6875rem;
        color: rgba(123,201,245,0.6);
        margin-top: 0.125rem;
    }

    @keyframes pulse-dot {
        0%, 100% { opacity: 1; box-shadow: 0 0 6px #ff0087; }
        50%       { opacity: 0.6; box-shadow: 0 0 12px #ff0087; }
    }

    .hero__dash-live-dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #22C55E;
        animation: pulse-dot 2s ease-in-out infinite;
    }

    .hero__dash-mini-label {
        font-size: 0.875rem;
        font-weight: 700;
        color: rgba(255,255,255,0.95);
        margin-bottom: 0.2rem;
    }

    .hero__dash-mini-desc {
        font-size: 0.6875rem;
        color: rgba(123,201,245,0.6);
    }

    /* ── Media ──────────────────────────────────────────────────────────────── */
    .hero__media { flex: 1; max-width: 50%; }
    .hero--center .hero__media { max-width: 70%; }
    .hero__image { width: 100%; height: auto; border-radius: 0.5rem; }

    /* ── Scroll arrow ───────────────────────────────────────────────────────── */
    .hero__scroll-arrow {
        position: absolute;
        bottom: 2rem;
        left: 50%;
        transform: translateX(-50%);
        font-size: 1.25rem;
        color: rgba(123,201,245,0.4);
        animation: bounce 2.5s ease-in-out infinite;
        z-index: 1;
        letter-spacing: -2px;
    }

    @keyframes bounce {
        0%, 100% { transform: translateX(-50%) translateY(0); }
        50%       { transform: translateX(-50%) translateY(8px); }
    }

    /* ── Mobile ─────────────────────────────────────────────────────────────── */
    @media (max-width: 767px) {
        .hero[data-theme="dark"] {
            min-height: calc(100svh - var(--nav-height, 0px));
            padding-top: clamp(2rem, 8svh, 3.5rem);
            padding-bottom: clamp(2rem, 6svh, 4rem);
            align-items: center;
        }

        .hero__inner {
            flex-direction: column !important;
            text-align: left;
            gap: 2rem;
        }

        .hero--left .hero__content {
            flex: 1 1 0;
            min-width: 0;
            max-width: 100%;
        }

        .hero__dashboard { display: none; }

        .hero__ctas {
            flex-direction: column;
        }

        .hero__cta {
            width: 100%;
            justify-content: center;
        }

        /* 2×2 grid for stats */
        .hero__stats {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem 1.5rem;
        }

        .hero__stat-value { font-size: 1.25rem; }

        .hero--left .hero__title,
        .hero__title {
            font-size: clamp(1.5rem, 7vw, 1.875rem);
        }

        .hero__media { max-width: 100%; }
    }
</style>
