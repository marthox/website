---
import type { Section } from '@/types/page';
import RichText from '@components/RichText.astro';

interface Props {
    section: Section;
}

const { section } = Astro.props;
---

<section class="carousel-section" data-theme={section.theme}>
    <div class="carousel-section__inner">
        {(section.title || section.subtitle) && (
            <div class="carousel-section__header">
                {section.title && <h2 class="carousel-section__title">{section.title}</h2>}
                {section.subtitle && <p class="carousel-section__subtitle">{section.subtitle}</p>}
            </div>
        )}
        {section.items && section.items.length > 0 && (
            <div class="carousel" role="region" aria-label={section.title ?? 'Carousel'}>
                <div class="carousel__track">
                    {section.items.map((item, i) => (
                        <div class="carousel__slide" id={`slide-${i}`}>
                            {item.mediaUrl && (
                                <div class="carousel__media">
                                    <img src={item.mediaUrl} alt={item.title ?? ''} class="carousel__image" />
                                </div>
                            )}
                            <div class="carousel__content">
                                {item.title && <h3 class="carousel__slide-title">{item.title}</h3>}
                                {item.subtitle && <p class="carousel__slide-subtitle">{item.subtitle}</p>}
                                <RichText doc={item.body} />
                                {item.ctas && item.ctas.length > 0 && (
                                    <div class="carousel__ctas">
                                        {item.ctas.map(cta => (
                                            <a
                                                href={cta.href}
                                                class={`carousel__cta carousel__cta--${cta.variant ?? 'primary'}`}
                                                target={cta.openInNewTab ? '_blank' : undefined}
                                                rel={cta.openInNewTab ? 'noopener noreferrer' : undefined}
                                            >
                                                {cta.label}
                                            </a>
                                        ))}
                                    </div>
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        )}
    </div>
</section>

<style>
    .carousel-section {
        padding: var(--section-padding-y, 4rem) var(--section-padding-x, 1.5rem);
        background-color: var(--section-bg);
        color: var(--section-text);
    }

    .carousel-section__inner {
        max-width: var(--container-width, 1200px);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .carousel-section__header {
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .carousel-section__title {
        font-size: clamp(1.5rem, 3vw, 2.25rem);
        font-weight: 700;
        margin: 0;
    }

    .carousel-section__subtitle {
        margin: 0 auto;
        max-width: 60ch;
        color: var(--section-text-muted);
    }

    .carousel {
        overflow: hidden;
    }

    .carousel__track {
        display: flex;
        gap: 1.5rem;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scrollbar-width: none;
        padding-bottom: 1rem;
    }

    .carousel__track::-webkit-scrollbar {
        display: none;
    }

    .carousel__slide {
        scroll-snap-align: start;
        flex: 0 0 min(100%, 32rem);
        border: 1px solid var(--section-border);
        border-radius: var(--radius-lg, 0.5rem);
        background-color: var(--section-surface);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .carousel__media {
        aspect-ratio: 16 / 9;
        overflow: hidden;
    }

    .carousel__image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .carousel__content {
        padding: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .carousel__slide-title {
        font-size: 1.125rem;
        font-weight: 600;
        margin: 0;
    }

    .carousel__slide-subtitle {
        margin: 0;
        color: var(--section-text-muted);
        font-size: 0.9375rem;
    }

    .carousel__ctas {
        margin-top: 0.75rem;
        display: flex;
        gap: 0.75rem;
    }

    .carousel__cta {
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
    }

    .carousel__cta--ghost {
        text-decoration: underline;
    }

    .carousel__cta--primary {
        padding: 0.5rem 1rem;
        background: var(--btn-primary-bg, var(--color-accent, #D4694A));
        color: var(--btn-primary-text);
        border-radius: 0;
    }

    .carousel__cta--secondary {
        padding: 0.5rem 1rem;
        border: 1px solid var(--btn-secondary-border);
        color: var(--btn-secondary-text);
        border-radius: 0.25rem;
    }
</style>
