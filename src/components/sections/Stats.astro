---
import type { Section } from '@/types/page';
import RichText from '@components/RichText.astro';

interface Props {
    section: Section;
}

const { section } = Astro.props;
---

<section class="stats" data-theme={section.theme}>
    <div class="stats__inner">
        {(section.title || section.subtitle) && (
            <div class="stats__header">
                {section.title && <h2 class="stats__title">{section.title}</h2>}
                {section.subtitle && <p class="stats__subtitle">{section.subtitle}</p>}
                <RichText doc={section.body} />
            </div>
        )}
        {section.items && section.items.length > 0 && (
            <div class="stats__grid">
                {section.items.map(item => (
                    <div class="stat">
                        {item.value && <span class="stat__value">{item.value}</span>}
                        {item.title && <span class="stat__label">{item.title}</span>}
                        {item.subtitle && <span class="stat__description">{item.subtitle}</span>}
                    </div>
                ))}
            </div>
        )}
    </div>
</section>

<style>
    .stats {
        padding: var(--section-padding-y, 4rem) var(--section-padding-x, 1.5rem);
        background-color: var(--section-bg);
        color: var(--section-text);
    }

    .stats__inner {
        max-width: var(--container-width, 1200px);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .stats__header {
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .stats__title {
        font-size: clamp(1.5rem, 3vw, 2.25rem);
        font-weight: 700;
        margin: 0;
    }

    .stats__subtitle {
        margin: 0 auto;
        max-width: 60ch;
        color: var(--section-text-muted);
    }

    .stats__grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
        gap: 2rem;
        text-align: center;
    }

    .stat {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        align-items: center;
    }

    .stat__value {
        font-size: clamp(2rem, 5vw, 3.5rem);
        font-weight: 800;
        line-height: 1;
    }

    .stat__label {
        font-size: 0.9375rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .stat__description {
        font-size: 0.875rem;
        color: var(--section-text-muted);
    }
</style>
