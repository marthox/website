---
import type { Section } from '@/types/page';

interface Props {
    section: Section;
}

const { section } = Astro.props;
---

<section class="features" data-theme={section.theme}>
    <div class="features__inner">
        {(section.title || section.subtitle) && (
            <div class="features__header">
                {section.title && <h2 class="features__title">{section.title}</h2>}
                {section.subtitle && <p class="features__subtitle">{section.subtitle}</p>}
            </div>
        )}
        {section.items && section.items.length > 0 && (
            <div class="features__grid">
                {section.items.map(item => (
                    <div class="feature">
                        {item.icon && (
                            <div class="feature__icon-wrap">
                                <span class={`icon icon--${item.icon}`} aria-hidden="true" />
                            </div>
                        )}
                        <div class="feature__content">
                            {item.title && <h3 class="feature__title">{item.title}</h3>}
                            {item.subtitle && <p class="feature__subtitle">{item.subtitle}</p>}
                        </div>
                    </div>
                ))}
            </div>
        )}
    </div>
</section>

<style>
    .features {
        padding: var(--section-padding-y, 4rem) var(--section-padding-x, 1.5rem);
        background-color: var(--section-bg);
        color: var(--section-text);
    }

    .features__inner {
        max-width: var(--container-width, 1200px);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 3rem;
    }

    .features__header {
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .features__title {
        font-size: clamp(1.5rem, 3vw, 2.25rem);
        font-weight: 700;
        margin: 0;
    }

    .features__subtitle {
        margin: 0 auto;
        max-width: 60ch;
        color: var(--section-text-muted);
    }

    .features__grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
        gap: 2rem;
    }

    .feature {
        display: flex;
        gap: 1rem;
        align-items: flex-start;
    }

    .feature__icon-wrap {
        font-size: 1.75rem;
        flex-shrink: 0;
        line-height: 1;
    }

    .feature__content {
        display: flex;
        flex-direction: column;
        gap: 0.375rem;
    }

    .feature__title {
        font-size: 1.0625rem;
        font-weight: 600;
        margin: 0;
    }

    .feature__subtitle {
        margin: 0;
        color: var(--section-text-muted);
        font-size: 0.9375rem;
        line-height: 1.6;
    }
</style>
