---
import type { Section } from "@/types/page";
import RichText from "@components/RichText.astro";

interface Props {
    section: Section;
}

const { section } = Astro.props;

const isSplit = section.layout === "split";
---

<section
    class={`features ${isSplit ? "features--split" : ""}`}
    data-theme={section.theme}
>
    {
        isSplit && (
            <div class="features__globe" aria-hidden="true">
                <svg
                    viewBox="0 0 300 300"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                >
                    <defs>
                        <clipPath id="globe-clip">
                            <circle cx="150" cy="150" r="145" />
                        </clipPath>
                        <radialGradient
                            id="sphere-glow"
                            cx="38%"
                            cy="32%"
                            r="55%"
                        >
                            <stop
                                offset="0%"
                                stop-color="#0099ff"
                                stop-opacity="0.12"
                            />
                            <stop
                                offset="100%"
                                stop-color="#ff0087"
                                stop-opacity="0"
                            />
                        </radialGradient>
                    </defs>
                    <circle
                        cx="150"
                        cy="150"
                        r="145"
                        fill="url(#sphere-glow)"
                    />
                    <g
                        clip-path="url(#globe-clip)"
                        stroke="#0099ff"
                        stroke-width="0.6"
                        fill="none"
                        opacity="0.3"
                    >
                        <ellipse cx="150" cy="24" rx="72" ry="9" />
                        <ellipse cx="150" cy="78" rx="126" ry="14" />
                        <ellipse cx="150" cy="150" rx="145" ry="17" />
                        <ellipse cx="150" cy="222" rx="126" ry="14" />
                        <ellipse cx="150" cy="276" rx="72" ry="9" />
                    </g>
                    <g
                        clip-path="url(#globe-clip)"
                        stroke="#0099ff"
                        stroke-width="0.6"
                        fill="none"
                        opacity="0.3"
                    >
                        <line x1="150" y1="5" x2="150" y2="295" />
                        <ellipse cx="150" cy="150" rx="72" ry="145" />
                        <ellipse cx="150" cy="150" rx="126" ry="145" />
                    </g>
                    <circle
                        cx="150"
                        cy="150"
                        r="145"
                        stroke="#0099ff"
                        stroke-width="1"
                        opacity="0.4"
                    />
                    <circle
                        cx="132"
                        cy="61"
                        r="3.5"
                        fill="#0099ff"
                        opacity="0.95"
                    />
                    <circle
                        cx="132"
                        cy="61"
                        r="7"
                        stroke="#0099ff"
                        stroke-width="1"
                        fill="none"
                        class="globe-ping"
                    />
                    <circle
                        cx="132"
                        cy="61"
                        r="11"
                        stroke="#0099ff"
                        stroke-width="0.5"
                        fill="none"
                        class="globe-ping globe-ping--delay"
                    />
                    <text
                        x="142"
                        y="59"
                        font-size="7.5"
                        fill="#0099ff"
                        font-family="monospace"
                        letter-spacing="1.8"
                        opacity="0.85"
                    >
                        US
                    </text>
                    <circle
                        cx="222"
                        cy="188"
                        r="3.5"
                        fill="#ff0087"
                        opacity="0.95"
                    />
                    <circle
                        cx="222"
                        cy="188"
                        r="7"
                        stroke="#ff0087"
                        stroke-width="1"
                        fill="none"
                        class="globe-ping globe-ping--offset"
                    />
                    <circle
                        cx="222"
                        cy="188"
                        r="11"
                        stroke="#ff0087"
                        stroke-width="0.5"
                        fill="none"
                        class="globe-ping globe-ping--delay globe-ping--offset"
                    />
                    <text
                        x="232"
                        y="186"
                        font-size="7.5"
                        fill="#ff0087"
                        font-family="monospace"
                        letter-spacing="1.8"
                        opacity="0.85"
                    >
                        LATAM
                    </text>
                    <path
                        d="M 132 64 Q 200 130 222 185"
                        stroke="url(#sphere-glow)"
                        stroke-width="0.75"
                        stroke-dasharray="3 4"
                        fill="none"
                        opacity="0.5"
                    />
                </svg>
            </div>
        )
    }
    <div class="features__inner">
        {
            (section.title || section.subtitle || section.body) && (
                <div class="features__header">
                    {section.subtitle && (
                        <span class="features__eyebrow">
                            {section.subtitle}
                        </span>
                    )}
                    {section.title && (
                        <h2 class="features__title" set:html={section.title} />
                    )}
                    <RichText doc={section.body} />
                    {isSplit && section.ctas && section.ctas.length > 0 && (
                        <div class="features__ctas">
                            {section.ctas.map((cta) => (
                                <a
                                    href={cta.href}
                                    class={`features__cta features__cta--${cta.variant ?? "primary"}`}
                                    target={
                                        cta.openInNewTab ? "_blank" : undefined
                                    }
                                    rel={
                                        cta.openInNewTab
                                            ? "noopener noreferrer"
                                            : undefined
                                    }
                                >
                                    {cta.label}
                                </a>
                            ))}
                        </div>
                    )}
                </div>
            )
        }
        {
            section.items && section.items.length > 0 && (
                <div class="features__right">
                    <div class="features__grid">
                        {section.items
                            .filter((item) => item.type !== "testimonial")
                            .map((item) => (
                                <div class="feature">
                                    <div class="feature__header">
                                        {item.icon && (
                                            <div
                                                class="feature__icon-wrap"
                                                aria-hidden="true"
                                            >
                                                {item.icon.startsWith('/') ? (
                                                    <img
                                                        src={item.icon}
                                                        class="feature__icon feature__icon--img"
                                                        width="28"
                                                        height="28"
                                                    />
                                                ) : (
                                                    <span class="feature__icon">
                                                        {item.icon}
                                                    </span>
                                                )}
                                            </div>
                                        )}
                                        <div class="feature__header-text">
                                            {item.title && (
                                                <h3 class="feature__title">
                                                    {item.title}
                                                </h3>
                                            )}
                                            {item.subtitle && (
                                                <p class="feature__subtitle">
                                                    {item.subtitle}
                                                </p>
                                            )}
                                        </div>
                                    </div>
                                    {item.body && (
                                        <div class="feature__content">
                                            <RichText doc={item.body} />
                                        </div>
                                    )}
                                </div>
                            ))}
                    </div>
                    {section.items
                        .filter((item) => item.type === "testimonial")
                        .map((item) => (
                            <blockquote class="features__quote">
                                {item.body && <RichText doc={item.body} />}
                                {item.subtitle && (
                                    <cite class="features__quote-cite">
                                        {item.subtitle}
                                    </cite>
                                )}
                            </blockquote>
                        ))}
                </div>
            )
        }
    </div>
</section>

<style>
    .features {
        padding: var(--section-padding-y, 4rem) var(--section-padding-x, 1.5rem);
        background-color: var(--section-bg);
        color: var(--section-text);
        position: relative;
        overflow: hidden;
    }

    /* ── Globe decoration (split layout only) ──────────────────────────── */
    .features__globe {
        position: absolute;
        right: -80px;
        top: 50%;
        transform: translateY(-50%);
        width: 420px;
        height: 420px;
        opacity: 0.13;
        pointer-events: none;
        z-index: 0;
    }

    .features__globe svg {
        width: 100%;
        height: 100%;
    }

    @keyframes globe-pulse {
        0% {
            opacity: 0.75;
            transform: scale(1);
        }
        100% {
            opacity: 0;
            transform: scale(1.7);
        }
    }

    :global(.globe-ping) {
        transform-box: fill-box;
        transform-origin: center;
        animation: globe-pulse 2.4s ease-out infinite;
    }

    :global(.globe-ping--delay) {
        animation-delay: 0.9s;
    }
    :global(.globe-ping--offset) {
        animation-delay: 1.2s;
    }
    :global(.globe-ping--delay.globe-ping--offset) {
        animation-delay: 2.1s;
    }

    @media (max-width: 767px) {
        .features__globe {
            width: 280px;
            height: 280px;
            right: -60px;
            opacity: 0.08;
        }
    }

    .features__inner {
        max-width: var(--container-width, 1200px);
        margin: 0 auto;
        display: flex;
        flex-direction: column;
        gap: 3rem;
        position: relative;
        z-index: 1;
    }

    .features__header {
        text-align: center;
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .features__title {
        font-size: clamp(1.5rem, 3vw, 2.25rem);
        font-weight: 700;
        margin: 0;
    }

    .features__eyebrow {
        font-size: 0.8125rem;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-accent);
    }

    .features__subtitle {
        margin: 0 auto;
        max-width: 60ch;
        color: var(--section-text-muted);
    }

    .features__right {
        position: relative;
    }

    .features__grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
        gap: 2rem;
    }

    .feature {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .feature__header {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .feature__header-text {
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        flex: 1;
        min-width: 0;
    }

    .feature__icon-wrap {
        flex-shrink: 0;
        width: 3.5rem;
        height: 3.5rem;
        border-radius: 0.75rem;
        background-color: color-mix(
            in srgb,
            var(--color-accent) 12%,
            transparent
        );
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    /* Alternate icon colors — even items use blue accent */
    .feature:nth-child(2n) .feature__icon-wrap {
        background-color: rgba(0, 153, 255, 0.12);
    }

    .feature:nth-child(3n) .feature__icon-wrap {
        background-color: rgba(255, 0, 135, 0.08);
        border: 1px solid rgba(255, 0, 135, 0.15);
    }

    /* Feature cards on dark theme — add subtle border */
    [data-theme="dark"] .feature {
        padding: 1.25rem;
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 0.75rem;
        transition: border-color 0.2s, background 0.2s;
        background: rgba(255, 255, 255, 0.02);
    }

    [data-theme="dark"] .feature:hover {
        border-color: rgba(255, 0, 135, 0.2);
        background: rgba(255, 0, 135, 0.03);
    }

    .feature__icon {
        font-size: 1.25rem;
        line-height: 1;
    }

    .feature__icon--img {
        width: 3rem;
        height: 3rem;
        object-fit: contain;
        transform: scale(2.2);
        filter: brightness(0) invert(0.15);
    }

    [data-theme="dark"] .feature__icon--img {
        filter: brightness(0) invert(1);
    }

    .feature__content {
        color: var(--section-text-muted);
        font-size: 0.9375rem;
        line-height: 1.65;
    }

    .feature__title {
        font-size: 1.0625rem;
        font-weight: 600;
        margin: 0;
    }

    .feature__subtitle {
        margin: 0;
        color: var(--color-accent);
        font-size: 0.8125rem;
        font-weight: 500;
        line-height: 1.4;
        letter-spacing: 0.01em;
    }

    .features--split .features__inner {
        flex-direction: row;
        align-items: flex-start;
        gap: 4rem;
    }

    .features--split .features__header {
        flex: 0 0 35%;
        text-align: left;
    }

    .features--split .features__right {
        flex: 1;
        position: relative;
    }

    .features--split .features__grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .features__title :global(.accent) {
        color: var(--color-accent);
    }

    .features__ctas {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 0.5rem;
    }

    .features__cta {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        font-weight: 600;
        font-size: 0.9375rem;
        text-decoration: none;
        transition: color 0.15s;
    }

    .features__cta--ghost {
        color: var(--section-text);
        text-decoration: underline;
        text-underline-offset: 3px;
        text-decoration-color: var(--color-accent);
        text-decoration-thickness: 2px;
    }

    .features__cta--ghost:hover {
        color: var(--color-accent);
    }

    .features__cta--primary {
        background: var(--gradient-brand, linear-gradient(135deg, #0099ff 0%, #ff0087 100%));
        color: var(--btn-primary-text);
        padding: 0.625rem 1.5rem;
        border-radius: 0.375rem;
    }

    .features__cta--secondary {
        border: 2px solid var(--btn-secondary-border);
        color: var(--btn-secondary-text);
        padding: 0.625rem 1.5rem;
        border-radius: 0.375rem;
    }

    .features__quote {
        margin: 2rem 0 0;
        padding: 0 0 0 1.25rem;
        border-left: 3px solid var(--color-accent);
        font-style: italic;
        font-size: 1.0625rem;
        line-height: 1.65;
        color: var(--section-text-muted);
    }

    .features__quote :global(p) {
        margin: 0;
    }

    .features__quote-cite {
        display: block;
        margin-top: 0.5rem;
        font-style: normal;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--color-accent);
    }

    .features--split .features__header :global(em) {
        display: block;
        font-style: italic;
        color: var(--section-text-muted);
        margin-top: 1.5rem;
        font-size: 0.9375rem;
        line-height: 1.7;
        border-left: 2px solid var(--color-accent);
        padding-left: 1rem;
    }

    .features__orb {
        position: absolute;
        right: -2rem;
        bottom: 2rem;
        width: 280px;
        height: 280px;
        border-radius: 50%;
        background: radial-gradient(
            circle at 30% 30%,
            rgba(0, 180, 255, 0.15),
            rgba(255, 45, 122, 0.05) 60%,
            transparent
        );
        border: 1px solid rgba(0, 180, 255, 0.2);
        pointer-events: none;
    }

    @media (max-width: 900px) {
        .features--split .features__inner {
            flex-direction: column;
        }
        .features--split .features__grid {
            grid-template-columns: 1fr;
        }
        .features__orb {
            display: none;
        }
    }
</style>
